<mxfile host="app.diagrams.net" modified="2026-11-10T23:00:00.000Z" agent="Mozilla/5.0" version="24.7.17" type="device"><diagram id="uml-electronic" name="Diagrama de Classes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="inh_pf" value="herança" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;" edge="1" parent="1" source="pf" target="pessoa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inh_pj" value="herança" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;" edge="1" parent="1" source="pj" target="pessoa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc" value="1 para 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=none;endArrow=none;" edge="1" parent="1" source="pessoa" target="endereco"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pessoa" value="&lt;b&gt;Pessoa (classe base)&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br/&gt;- nome: String&lt;br/&gt;- endereco: Endereco&lt;hr/&gt;&lt;b&gt;Métodos&lt;/b&gt;&lt;br/&gt;+ Pessoa(nome, endereco)&lt;br/&gt;+ get nome(): String&lt;br/&gt;+ set nome(valor): void&lt;br/&gt;+ get endereco(): Endereco&lt;br/&gt;+ set endereco(valor): void&lt;br/&gt;+ exibirDados(): String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#527a50;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="340" height="230" as="geometry"/></mxCell><mxCell id="pf" value="&lt;b&gt;PessoaFisica&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br/&gt;- cpf: String&lt;br/&gt;- dataNascimento: String&lt;hr/&gt;&lt;b&gt;Métodos&lt;/b&gt;&lt;br/&gt;+ PessoaFisica(nome, cpf, dataNascimento, endereco)&lt;br/&gt;+ get/set cpf&lt;br/&gt;+ get/set dataNascimento&lt;br/&gt;+ exibirDados(): String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b89b45;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="380" height="220" as="geometry"/></mxCell><mxCell id="pj" value="&lt;b&gt;PessoaJuridica&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br/&gt;- cnpj: String&lt;br/&gt;- razaoSocial: String&lt;hr/&gt;&lt;b&gt;Métodos&lt;/b&gt;&lt;br/&gt;+ PessoaJuridica(nome, cnpj, razaoSocial, endereco)&lt;br/&gt;+ get/set cnpj&lt;br/&gt;+ get/set razaoSocial&lt;br/&gt;+ exibirDados(): String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="390" width="380" height="220" as="geometry"/></mxCell><mxCell id="endereco" value="&lt;b&gt;Endereco&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br/&gt;- logradouro: String&lt;br/&gt;- numero: String&lt;br/&gt;- cidade: String&lt;br/&gt;- uf: String&lt;hr/&gt;&lt;b&gt;Métodos&lt;/b&gt;&lt;br/&gt;+ Endereco(logradouro, numero, cidade, uf)&lt;br/&gt;+ getters e setters dos atributos&lt;br/&gt;+ toString(): String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="390" width="340" height="220" as="geometry"/></mxCell><mxCell id="note" value="Notação UML: + público | - privado | # protegido. No código JavaScript, os atributos privados são declarados com #." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="600" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>